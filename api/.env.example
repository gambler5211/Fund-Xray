# Copy to api/.env and fill in. Never commit the real .env.
WEB_ORIGIN=http://localhost:3000

# Day 3 — Supabase. The URL alone lets the API check sign-in tokens (public signing keys).
SUPABASE_URL=https://dgjbladcfysjncciukhg.supabase.co
# Day 4 — the publishable key (sb_publishable_..., same one the web app uses). The API calls
# Supabase as the signed-in user, so no secret key is needed.
SUPABASE_PUBLISHABLE_KEY=

# Day 4 — Kite Connect (developers.kite.trade → your app)
KITE_API_KEY=
KITE_API_SECRET=
# Informational only: set the Kite app's Redirect URL to the WEB app, e.g.
# https://fund-xray-theta.vercel.app/kite/callback
KITE_REDIRECT_URL=

# Day 4 — encryption key for stored Kite tokens. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
