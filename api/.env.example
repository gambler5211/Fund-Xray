# Copy to api/.env and fill in. Never commit the real .env.
WEB_ORIGIN=http://localhost:3000

# Day 3 — Supabase. The URL alone lets the API check sign-in tokens (public signing keys).
SUPABASE_URL=https://dgjbladcfysjncciukhg.supabase.co
# Day 4 — Project settings → API Keys → Secret key (sb_secret_...). Never in the web app.
SUPABASE_SECRET_KEY=

# Day 4 — Kite Connect (developers.kite.trade → your app)
KITE_API_KEY=
KITE_API_SECRET=
KITE_REDIRECT_URL=http://localhost:8000/kite/callback

# Day 4 — encryption key for stored Kite tokens. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
